	$(MAKE) $(MAKESILENT) -f CMakeFiles/app.dir/build.make CMakeFiles/app.dir/src/rtems/tasks/sendreports_task.cpp.s
.PHONY : src/rtems/tasks/sendreports_task.cpp.s

